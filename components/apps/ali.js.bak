                                    {Object.keys(categories).map((category) => {
                                        const isActive = activeCategory === category;
                                        return (
                                            <div
                                                key={category}
                                                onClick={() => setActiveCategory(category)}
                                                className="flex items-center space-x-2 px-2 py-2 rounded cursor-pointer transition-all"
                                                style={{
                                                    backgroundColor: isActive ? 'rgba(82, 148, 226, 0.15)' : 'transparent',
                                                    borderLeft: isActive ? '3px solid #5294e2' : '3px solid transparent',
                                                    color: isActive ? 'rgba(255, 255, 255, 0.95)' : 'rgba(255, 255, 255, 0.7)',
                                                    fontSize: '13px'
                                                }}
                                                onMouseEnter={(e) => {
                                                    if (!isActive) {
                                                        e.currentTarget.style.backgroundColor = 'rgba(255, 255, 255, 0.05)';
                                                    }
                                                }}
                                                onMouseLeave={(e) => {
                                                    if (!isActive) {
                                                        e.currentTarget.style.backgroundColor = 'transparent';
                                                    }
                                                }}
                                            >
                                                <svg className="w-4 h-4 flex-shrink-0" style={{color: isActive ? '#5294e2' : '#7d7d7d'}} fill="currentColor" viewBox="0 0 20 20">
                                                    <path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" />
                                                </svg>
                                                <span className="truncate">{category}</span>
                                            </div>
                                        );
                                    })}
                                </div>
                            </div>
                        </div>

                        {/* Right Content - File Grid */}
                        <div className="flex-1 overflow-auto" style={{
                            backgroundColor: '#1e1e1e',
                            padding: '20px'
                        }}>
