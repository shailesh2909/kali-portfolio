                </div>
            </div>
            <ul className=" w-10/12  mt-4 ml-4 px-0 md:px-1">
                <li className="list-disc">
                    <div className=" text-lg md:text-xl text-left font-bold leading-tight">
                    Bachelor of Technology - Electronics and Telecommunication
                    </div>
                    <div className=" text-sm text-gray-400 mt-0.5">Expected Graduation: 2027</div>
                    <div className=" text-sm md:text-base">Pune Institute of Computer Technology</div>
                    <div className="text-sm text-gray-300 font-bold mt-1">CGPA: 8.32 | Location: Pune, India</div>
                </li>
                <li className="list-disc mt-5">
                    <div className=" text-lg md:text-xl text-left font-bold leading-tight">
                    Diploma in Computer Science and Engineering
                    </div>
                    <div className=" text-sm text-gray-400 mt-0.5">Graduated: 2024</div>
                    <div className=" text-sm md:text-base">Government Polytechnic Khamgaon</div>
